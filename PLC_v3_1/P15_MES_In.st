(* ============================================================
   P15_MES_In  中控 Modbus TCP 輸入（Host → PLC）  v3.1
   FX5S 的 D 只到 D7999，交握表的 D10000 區改放 D7000：
     Modbus 保持暫存器 0x0000~0x00FF ↔ D7000~D7255（GX Works3 MODBUS 裝置分配）
     表上 D10000 → D7000、D10100 → D7100（PLC 內部位址 = 表上位址 - 3000，Modbus 位址不變）
   Host→PLC：D7000 心跳、D7001 系統訊息、D7002 控制位元、D7003~D7023 字串、D7024~D7029 校時
   v3.1：依中控 V10 與 car_light_system 實作修正——心跳中斷自動降 Local、ACK 改看準位、
         收到 ACK完工 清完工待收與 Result_Ready、放行單次使用
   ============================================================ *)

(* ---- 模擬中控：模擬模式 M50 且 HMI「模擬中控」M2070 ON 時，PLC 自己扮演中控 ---- *)
IF M50 AND M2070 THEN
    M2072 := SM412 AND NOT M2073;  M2073 := SM412;   (* 每秒一次 *)
    IF M2072 THEN
        IF D7000 >= 32767 THEN D7000 := 0; ELSE D7000 := D7000 + 1; END_IF;
    END_IF;
    M2150 := TRUE;              (* B00 Remote *)
    M2151 := NOT M2071 AND (D100 = 14);   (* B01 放行：只在 PLC 等放行時給；M2071 = HMI「模擬中控拒絕」 *)
    M2152 := FALSE;  M2153 := FALSE;
    M2154 := M2121;             (* B04 ACK開始：跟著 PLC 開始請求 *)
    M2155 := M2122;             (* B05 ACK完工：跟著 PLC 完工通知（真中控要等出站重刷與入庫） *)
    M2156 := FALSE;  M2157 := FALSE;  M2158 := FALSE;  M2159 := FALSE;
    M2160 := FALSE;  M2161 := FALSE;  M2162 := FALSE;  M2163 := FALSE;
    M2164 := FALSE;  M2165 := FALSE;
    D7002 := K4M2150;
    IF M2071 THEN D7001 := 7; ELSIF M2121 THEN D7001 := 9; END_IF;   (* 7 靜電未Pass / 9 進站成功 *)
END_IF;

(* ---- 控制位元拆解：D7002 → M2030~M2045（M2030 = B00 … M2045 = B15） ---- *)
K4M2030 := D7002;
(* M2030 B00 Remote 系統模式、M2031 B01 防呆放行 Interlock Pass、M2034 B04 ACK開始、M2035 B05 ACK完工 *)

(* ---- 中控心跳：數值有變化就算連線；D216（預設 5 秒）沒變化 = 通訊中斷 ---- *)
IF D7000 <> D2001 THEN
    D2001 := D7000;
    D2002 := 0;
    M2052 := FALSE;
ELSIF M950 AND (D2002 < 32000) THEN
    D2002 := D2002 + 1;
END_IF;
IF D2002 >= D216 THEN M2052 := TRUE; END_IF;

(* ---- Remote / Local：HMI 選 Remote、中控 B00 = Remote、且心跳正常才是 Remote ----
   心跳中斷自動降 Local，恢復後中控寫 B00=1 即自動回 Remote（V10 5.4、失聯契約第八節）
   只在停止或待機時切換；加工中斷線則做完這一件 *)
IF (D100 = 0) OR (D100 = 10) THEN
    M2051 := M2050 AND M2030 AND NOT M2052;
END_IF;

(* 有效放行：通訊中斷時放行位元可能是舊值，不算數 *)
M2053 := M2031 AND NOT M2052;

(* 放行單次使用：用過一次後，要看到中控把 B01 清回 0 才可再用 *)
IF NOT M2031 THEN M2114 := FALSE; END_IF;

(* 完工交握（四階段）：PLC 完工 B02=1 → 中控 ACK完工 B05=1 → PLC 清 B02、B09 → 中控清 B05
   完工待收 M2113 不受自動步序影響，加工停止或異常時資料仍保留到收到 ACK完工 *)
IF M2113 AND M2035 THEN
    M2113 := FALSE;
    M2111 := FALSE;   (* Result_Ready 一起清（第二站起的規定） *)
END_IF;

(* 完工待收期間中控斷線：亮紅燈異常，資料保留，恢復連線後中控續收（V10 5.4） *)
IF M2113 AND M2052 THEN M154 := TRUE; END_IF;

(* 警告：選 Remote 但中控通訊中斷；靜電檢查啟用且靜電不 OK *)
M152 := M2050 AND M2052;
M153 := (D214 <> 0) AND NOT M2062;

(* ---- 系統校時 D7024~D7029（年月日時分秒） ----
   中控寫入的值有變化、數值合理、且與 PLC 時鐘差到「分」以上，才寫入 PLC 時鐘（避免每秒重寫）
   寫法：SD210~SD216 放新時間，SM210 ON 一個掃描（實機請驗證，見說明文件） *)
IF M2081 THEN
    SM210 := FALSE;
    M2081 := FALSE;
END_IF;
M2080 := (D7024 <> D2010) OR (D7025 <> D2011) OR (D7026 <> D2012)
         OR (D7027 <> D2013) OR (D7028 <> D2014) OR (D7029 <> D2015);
IF M2080 THEN
    D2010 := D7024;  D2011 := D7025;  D2012 := D7026;
    D2013 := D7027;  D2014 := D7028;  D2015 := D7029;
    IF NOT M2052
       AND (D7024 >= 2000) AND (D7024 <= 2099) AND (D7025 >= 1) AND (D7025 <= 12)
       AND (D7026 >= 1) AND (D7026 <= 31) AND (D7027 >= 0) AND (D7027 <= 23)
       AND (D7028 >= 0) AND (D7028 <= 59) AND (D7029 >= 0) AND (D7029 <= 59)
       AND ((D7024 <> SD210) OR (D7025 <> SD211) OR (D7026 <> SD212)
            OR (D7027 <> SD213) OR (D7028 <> SD214)) THEN
        (* 星期（Zeller 公式），0 = 星期日 *)
        D2020 := D7024;
        D2021 := D7025;
        IF D2021 < 3 THEN
            D2021 := D2021 + 12;
            D2020 := D2020 - 1;
        END_IF;
        D2022 := (D7026 + (13 * (D2021 + 1)) / 5 + D2020 + D2020 / 4 - D2020 / 100 + D2020 / 400) MOD 7;
        SD210 := D7024;  SD211 := D7025;  SD212 := D7026;
        SD213 := D7027;  SD214 := D7028;  SD215 := D7029;
        SD216 := (D2022 + 6) MOD 7;
        SM210 := TRUE;
        M2081 := TRUE;
        D2016 := D2016 + 1;   (* 校時次數（HMI 監看用） *)
    END_IF;
END_IF;

(* ============================================================
   P00_Init  首掃描初始化（第一個執行）  v3.1
   專案：文字鎖螺絲機  主 PLC FX5S-30MR/ES
   v3 新增：中控（Modbus TCP）參數 D213/D214/D216、M2xxx 交握位元初始化
   v3.1：依中控 car_light_system V10 修正（中控回應逾時預設 30 秒、完工待收、放行單次使用）
   ============================================================ *)
IF SM402 THEN
    (* 參數若超出範圍就填入預設值（D200~D499 已在 CPU 參數設為停電保持） *)
    IF (D200 < 1) OR (D200 > 3) THEN D200 := 1; END_IF;   (* RC75 TABLE 編號 1~3 *)
    IF D210 <= 0 THEN D210 := 30;  END_IF;   (* 啟動逾時 3.0 秒  (0.1s) *)
    IF D211 <= 0 THEN D211 := 150; END_IF;   (* 鎖付逾時 15.0 秒 (0.1s) *)
    IF D212 <= 0 THEN D212 := 100; END_IF;   (* 原點復歸逾時 10.0 秒 (0.1s) *)
    IF D213 <= 0 THEN D213 := 300; END_IF;   (* 中控放行等待逾時 30.0 秒 (0.1s)，含 OP 掃碼時間 *)
    IF (D214 < 0) OR (D214 > 1) THEN D214 := 0; END_IF;   (* v3 靜電檢查 0=不檢查 1=檢查（接線前保持 0） *)
    IF D216 <= 0 THEN D216 := 50;  END_IF;   (* v3 中控心跳逾時 5.0 秒 (0.1s) *)
    IF D521 <= 0 THEN D521 := 20;  END_IF;   (* 模擬：RC75 鎖付時間 2.0 秒 (0.1s) *)

    (* 上電一律停止、自動模式、非模擬 *)
    M50  := FALSE;   (* 模擬模式 *)
    M59  := FALSE;   (* 模擬模式（已接受的狀態） *)
    M200 := FALSE;   (* 自動運轉中 *)
    M201 := FALSE;   (* 手動模式 *)
    M301 := FALSE;   (* 停止要求 *)
    M310 := FALSE;   (* 本次治具要求已處理 *)
    M320 := FALSE;   (* 循環完成 鎖存 *)
    M321 := FALSE;   (* 鎖付 OK 鎖存 *)
    M121 := FALSE;   (* 蜂鳴器靜音 *)
    M932 := FALSE;   (* 手動單次鎖付要求（M384~M1999 預設停電保持，要清） *)
    D100 := 0;       (* 自動步序 *)
    D101 := 0;
    D110 := 0;       (* 復歸步序 *)
    D111 := 0;

    (* v3 中控 *)
    M2050 := TRUE;   (* HMI Remote/Local 選擇：上電預設 Remote【待確認】 *)
    M2051 := FALSE;  (* 目前模式 Remote *)
    M2052 := TRUE;   (* 中控通訊中斷：看到心跳變化才解除 *)
    M2070 := FALSE;  (* 模擬中控 *)
    M2081 := FALSE;  (* 校時寫入中 *)
    M2111 := FALSE;  (* Result_Ready *)
    M2112 := FALSE;  (* Overall_Result *)
    M2113 := FALSE;  (* 完工待收（等 ACK完工） *)
    M2114 := FALSE;  (* 放行已使用 *)
    M154  := FALSE;  (* 完工待收時中控斷線 *)
    D2002 := 0;      (* 心跳計時 *)
END_IF;

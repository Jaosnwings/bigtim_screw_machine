(* ============================================================
   P10_Input  實體輸入 → 內部 M（只有這裡讀 X）  v3.2
   v3.2b（11-09）：啟動鍵改看 X1。v3.2：依 2026-11-02 現場對點（點位表 + RC75 手寫 + 現場回覆）重新對應
     M0 X0 急停 EMO（NC：ON=正常）   M7  X1 啟動鈕（HMI 箱綠鍵，11-09 現場確認接 X1）
     M3 X3 靜電 NG                    M10 X10 安全光柵（ON=無遮斷）
     M5 X5 治具水平待命               M11 X11 RC75 READY   YB00
     M6 X6 治具停止                   M12 X12 RC75 HOME    YB01
     X1、X2、X4 未使用                M13 X13 RC75 ALARM   YB02
                                      M14 X14 RC75 循環完成 YB04
                                      M15 X15 螺絲上膛（Check tip screw，v3.10 改定義；原為螺絲不足）
                                      M16 X16 RC75 蜂鳴    YB12（只顯示）
                                      M17 X17 RC75 締付 OK YB13
   ============================================================ *)
IF NOT M50 THEN
    M0  := X0;
    M1  := X1;    (* 啟動鈕原始訊號 *)
    M2  := X2;    (* 未使用 *)
    M3  := X3;
    M4  := X4;    (* 未使用 *)
    M5  := X5;
    M6  := X6;
    M7  := X1;    (* 11-09 現場：綠色啟動鍵接 X1（X7 v3.12 改為治具到位，見 M18） *)
    M10 := X10;
    M11 := X11;
    M12 := X12;
    M13 := X13;
    M14 := X14;
    M15 := X15;
    M16 := X16;
    M17 := X17;
    M18 := X7;    (* v3.12：X7 治具到位（可以鎖螺絲） *)
ELSE
    (* 模擬：P05 產生 M54 治具水平、M60~M66 RC75；HMI 模擬按鈕 *)
    M0  := X0 AND NOT M57;   (* M57 = HMI「模擬急停」 *)
    M1  := FALSE;
    M2  := FALSE;
    M3  := M2065;            (* HMI「模擬靜電 NG」 *)
    M4  := FALSE;
    M5  := M54;
    M6  := M55;
    M7  := M53;              (* HMI「模擬啟動鈕」 *)
    M10 := NOT M58;          (* HMI「模擬光柵遮斷」 *)
    M11 := M60;
    M12 := M61;
    M13 := M62;
    M14 := M64;
    M15 := M66;
    M16 := FALSE;
    M17 := M65;
    M18 := TRUE;             (* v3.12 模擬：治具視為到位 *)
END_IF;

(* 靜電：X3 = NG 乾接點 *)
M2060 := NOT M3;   (* 靜電 OK *)
M2061 := M3;       (* 靜電 NG *)

(* HMI 按鈕（v3.2 沒有實體復歸／停止鈕） *)
M20 := M100;    (* 自動啟動 *)
M21 := M101;    (* 停止 *)
M22 := M102;    (* 復歸 *)

(* 上升沿 *)
M30 := M20 AND NOT M31;  M31 := M20;   (* 自動啟動 *)
M32 := M21 AND NOT M33;  M33 := M21;   (* 停止 *)
M34 := M22 AND NOT M35;  M35 := M22;   (* 復歸 *)
M36 := M7 AND NOT M37;   M37 := M7;    (* 啟動鈕 X1：每循環一次 *)


(* 靜電條件：不檢查（D214=0）或沒有 NG *)
M2062 := (D214 = 0) OR NOT M2061;

(* v3.12 X7 治具到位：ON 穩定 0.2 秒 = M940；M937 = 可接受下一點（X7 OFF 過才重新允許；按 X1 時 X7 還亮著不會馬上鎖，
   避免同一個到位訊號鎖兩次）。M937 由 P30 步 15、P40 手動接受一點時清除 *)
IF M18 THEN
    IF M950 AND (D547 < 32000) THEN D547 := D547 + 1; END_IF;
ELSE
    D547 := 0;
END_IF;
M940 := M18 AND (D547 >= 2);
IF NOT M18 THEN M937 := TRUE; END_IF;

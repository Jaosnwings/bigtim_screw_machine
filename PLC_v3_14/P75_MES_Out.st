(* ============================================================
   P75_MES_Out  中控 Modbus TCP 輸出（PLC → Host）  v3.2（v3.14 起後面接 P76_Sock_Out）
   v3.2：版號 302；Run 旗標改步序 15~60；D7200~D7204 給電腦側錄（io_rec.ps1 -HoldStart 200 -HoldCount 5）
   表上 D10100~D10132 → 本程式 D7100~D7132（Modbus 位址 0x0064~0x0084 不變）
   ============================================================ *)

(* D7100 PLC 心跳：把中控心跳原值寫回 *)
D7100 := D7000;

(* D7101~D7104 設備編號 "MC-D002"（8 字元，每個字放 2 字元）
   M2091 OFF：第 1 字元放高位元組（Modbus 一般慣例）；ON：放低位元組（三菱慣例）【待確認】 *)
IF NOT M2091 THEN
    D7101 := 16#4D43;   (* "MC" *)
    D7102 := 16#2D44;   (* "-D" *)
    D7103 := 16#3030;   (* "00" *)
    D7104 := 16#3220;   (* "2" + 空白（中控規定不足補空白） *)
ELSE
    D7101 := 16#434D;
    D7102 := 16#442D;
    D7103 := 16#3030;
    D7104 := 16#2032;
END_IF;

(* D7105 設備運作狀態 0 停止 / 1 運行中 / 2 異常 *)
IF M203 OR M154 THEN
    D7105 := 2;
ELSIF M200 THEN
    D7105 := 1;
ELSE
    D7105 := 0;
END_IF;

D7106 := 317;   (* PLC 版號 v3.17：socket 改用連線號碼 3～5（1、2 已給 SLMP、MODBUS） *)

(* D7107 狀態位元：先組 M2120~M2135，再一次寫入 *)
M2120 := FALSE;                         (* B00 未用 *)
M2121 := (D100 = 12);                   (* B01 實體開始：保持到中控 ACK開始 *)
M2122 := M2113;                         (* B02 完工：保持到中控 ACK完工（不逾時） *)
M2123 := M214;                          (* B03 機械異常中斷（不含鎖付 NG） *)
M2124 := M2060;                         (* B04 靜電 OK 乾接點 *)
M2125 := M2061;                         (* B05 靜電 NG 乾接點 *)
M2126 := FALSE;                         (* B06 未用 *)
M2127 := FALSE;                         (* B07 未用 *)
M2128 := M2051;                         (* B08 PLC 目前模式 1 = Remote *)
M2129 := M2111;                         (* B09 Result_Ready *)
M2130 := M2112;                         (* B10 Overall_Result 1 = OK *)
M2131 := FALSE;                         (* B11 未用 *)
M2132 := FALSE;                         (* B12 未用 *)
M2133 := M203 OR M154;                 (* B13 Alarm 旗標 *)
M2134 := M202 AND NOT M2113 AND ((D100 = 0) OR (D100 = 10));   (* B14 Ready 旗標：就緒待命 *)
M2135 := (D100 >= 15) AND (D100 <= 60);          (* B15 Run 旗標：加工中 *)
D7107 := K4M2120;

(* D7110~D7115 作業開始時間、D7116~D7121 作業結束時間、D7122 Cycle Time 0.1 秒 *)
D7110 := D2030;  D7111 := D2031;  D7112 := D2032;
D7113 := D2033;  D7114 := D2034;  D7115 := D2035;
D7116 := D2036;  D7117 := D2037;  D7118 := D2038;
D7119 := D2039;  D7120 := D2040;  D7121 := D2041;
D7122 := D2042;

(* ============================================================
   v3.08（11-11）SD550T 簡易網路：經 FX5-485ADP 讀鎖付結果
   規格：SD550T 通信仕様 V1.1x（SOP/20261111_nitto_drawings）。9600 8N1、終端 CR、站號 01（SD550T 的 Pa80 要設 0001）
   指令（ASCII 10 字元 + 模組自動加 CR）："01" "R" VNo(5) SUM(2) CR；SUM 填 "**" = 控制器不檢查
   回覆：正常 "01" "D0" 數值 4 位 SUM CR ／ "01" "D1" 數值 8 位 SUM CR；NG "01" "E0" 代碼 4 位 SUM CR
   每次鎖付完成（X14 上升）讀 7 筆：R0010 完了扭力、R0020 本締角度、R0030 扭力判定、R0031 角度判定、
     R0032 高度判定、R0053 鎖付時間、R0060 停止要因
   通道：485ADP = CH3（SM8581 送信要求、SM8582 受信完了、SD8582 受信字數）；模組參數要設「無協定、8 位元處理」
   D2060 步序（0 待命 1 送出 2 等回覆 3 間隔） D2061 第幾筆 D2062 計時 0.1s
   D2120~ 送信緩衝 D2140~ 受信緩衝（每字 1 位元組）
   D7140 扭力原值 D7141 角度（度）低字 D7142 角度高字 D7143 扭力判定 D7144 角度判定 D7145 高度判定
   D7146 鎖付時間 D7147 停止要因 D7148 通訊狀態（0 未讀 1 完成 2 逾時 3 NG 回覆 4 格式錯）
   D7149 通訊失敗次數 D7150 NG 代碼 D7151 完成次數 D7152 這份結果是第幾點（v3.15）；M861 = 手動測試讀一次（HMI／Modbus）
   v3.15：讀取中先放 D2170～D2177（點號 D2178），7 筆都成功才一起搬到 D7140～D7147、D7152；失敗則清 0
   ============================================================ *)
RS2(TRUE, D2120, 10, 20, 3, D2140);   (* 送 10 字元；終端 CR 由模組參數自動加上 *)

M863 := (M14 AND NOT M862) OR M861;
M862 := M14;
M861 := FALSE;

IF (D2060 = 0) AND M863 THEN
    D2061 := 0;
    D2060 := 1;
    (* v3.15：記下這次結果屬於第幾點（自動 D222、手動兩點 D546、其他 0），讀完才一起放到 D7152 *)
    IF M200 THEN
        D2178 := D222;
    ELSIF M201 THEN
        D2178 := D548;   (* 手動：鎖付開始時記下的點號（D546 在 Z 回原點時就會換點） *)
    ELSE
        D2178 := 0;
    END_IF;
END_IF;

CASE D2060 OF
1:  (* 組指令並送出 *)
    CASE D2061 OF
    0: D2126 := 16#31; D2127 := 16#30;   (* R0010 *)
    1: D2126 := 16#32; D2127 := 16#30;   (* R0020 *)
    2: D2126 := 16#33; D2127 := 16#30;   (* R0030 *)
    3: D2126 := 16#33; D2127 := 16#31;   (* R0031 *)
    4: D2126 := 16#33; D2127 := 16#32;   (* R0032 *)
    5: D2126 := 16#35; D2127 := 16#33;   (* R0053 *)
    6: D2126 := 16#36; D2127 := 16#30;   (* R0060 *)
    END_CASE;
    D2120 := 16#30;  D2121 := 16#31;     (* 站號 "01" *)
    D2122 := 16#52;                      (* "R" 讀出 *)
    D2123 := 16#52;  D2124 := 16#30;  D2125 := 16#30;   (* VNo "R00xx" *)
    D2128 := 16#2A;  D2129 := 16#2A;     (* SUM "**" *)
    (* CR 不放進緩衝：模組參數「終端 = 0D」會自動加 *)
    SM8582 := FALSE;
    SM8581 := TRUE;
    D2062 := 0;
    D2060 := 2;

2:  (* 等回覆，1.0 秒逾時 *)
    IF M950 THEN D2062 := D2062 + 1; END_IF;
    IF SM8582 THEN
        IF D2142 = 16#52 THEN
            SM8582 := FALSE;             (* 收到自己送出的回音，繼續等 *)
        ELSIF (D2142 = 16#44) AND (D2143 = 16#30) THEN
            D2063 := (D2144 - 48) * 1000 + (D2145 - 48) * 100 + (D2146 - 48) * 10 + (D2147 - 48);
            CASE D2061 OF
            0: D2170 := D2063;           (* v3.15：先放暫存，7 筆都讀完才一起搬到 D7140～D7147 *)
            2: D2173 := D2063;
            3: D2174 := D2063;
            4: D2175 := D2063;
            5: D2176 := D2063;
            6: D2177 := D2063;
            END_CASE;
            SM8582 := FALSE;
            D2060 := 3;
        ELSIF (D2142 = 16#44) AND (D2143 = 16#31) THEN
            D2063 := (D2144 - 48) * 1000 + (D2145 - 48) * 100 + (D2146 - 48) * 10 + (D2147 - 48);
            D2064 := (D2148 - 48) * 1000 + (D2149 - 48) * 100 + (D2150 - 48) * 10 + (D2151 - 48);
            D2171:D := INT_TO_DINT(D2063) * 10000 + INT_TO_DINT(D2064);
            SM8582 := FALSE;
            D2060 := 3;
        ELSIF D2142 = 16#45 THEN
            D7150 := (D2144 - 48) * 1000 + (D2145 - 48) * 100 + (D2146 - 48) * 10 + (D2147 - 48);
            D7148 := 3;
            D7149 := D7149 + 1;
            M942 := TRUE;
            SM8582 := FALSE;
            D2060 := 0;
        ELSE
            D7148 := 4;
            D7149 := D7149 + 1;
            M942 := TRUE;
            SM8582 := FALSE;
            D2060 := 0;
        END_IF;
    ELSIF D2062 >= 10 THEN
        D7148 := 2;
        D7149 := D7149 + 1;
        M942 := TRUE;
        SM8581 := FALSE;
        D2060 := 0;
    END_IF;

3:  (* 下一筆（隔一個掃描以上再送） *)
    D2061 := D2061 + 1;
    IF D2061 > 6 THEN
        (* v3.15：7 筆都成功 → 同一個掃描搬到上報區，socket ST 不會送出新舊混在一起的值 *)
        D7140 := D2170;
        D7141:D := D2171:D;
        D7143 := D2173;  D7144 := D2174;  D7145 := D2175;
        D7146 := D2176;  D7147 := D2177;
        D7152 := D2178;
        D7148 := 1;
        D7151 := D7151 + 1;
        D2060 := 0;
    ELSE
        D2060 := 1;
    END_IF;
END_CASE;

(* v3.15：這一輪讀取失敗（逾時、NG 回覆、格式錯）→ 結果清 0，避免中控把上一顆的值當成這一顆；D7148 說明原因 *)
IF M942 THEN
    D7140 := 0;  D7141:D := 0;  D7143 := 0;  D7144 := 0;  D7145 := 0;
    D7146 := 0;  D7147 := 0;
    D7152 := D2178;
    M942 := FALSE;
END_IF;

(* v3.16（11-13）HMI 首頁分點顯示：每次讀完（成功或失敗）把扭力、鎖付時間放到該點的欄位。
   D7153 第 1 點扭力、D7154 第 1 點時間、D7155 第 2 點扭力、D7156 第 2 點時間（失敗 = 0）。
   點號 0（HMI 單次鎖付）當第 1 點；第 1 點有新結果時清掉第 2 點，避免顯示上一件的第 2 點 *)
IF D7151 <> D2179 OR D7149 <> D2180 THEN
    D2179 := D7151;
    D2180 := D7149;
    IF D7152 = 2 THEN
        D7155 := D7140;  D7156 := D7146;
    ELSE
        D7153 := D7140;  D7154 := D7146;
        D7155 := 0;      D7156 := 0;
    END_IF;
END_IF;

(* D7130 扭力、D7131 圈數：先放 SD550T 原值（扭力小數點位置與單位換算【待確認】）；D7132 鎖附曲線 SD550T 不提供 *)
D7130 := D7140;
D7131 := D7141;
D7132 := 0;

(* v3.2 電腦側錄用（Modbus 保持暫存器 200~204）：步序、第幾點、本步秒數、復歸步序、等待條件碼 *)
D7200 := D100;
D7201 := D222;
D7202 := D500;
D7203 := D110;
D7204 := D2051;

(* ============================================================
   P70_Output_Data  內部 M → 實體 Y（只有這裡寫 Y）、生產資料、HMI 燈號  v3.2
   v3.2：Y 對應改為現場點位表；每個 Y 加上 HMI 強制（P45 的 M870~M883）
   ============================================================ *)
IF M50 THEN
    Y0 := FALSE;  Y1 := FALSE;  Y2 := FALSE;  Y3 := FALSE;
    Y4 := FALSE;  Y5 := FALSE;  Y6 := FALSE;  Y7 := FALSE;
    Y10 := FALSE; Y11 := FALSE; Y12 := FALSE; Y13 := FALSE;
    Y14 := FALSE; Y15 := FALSE;
ELSE
    Y0  := M400 OR M870;   (* 塔燈紅 *)
    Y1  := M401 OR M871;   (* 塔燈綠 *)
    Y2  := M402 OR M872;   (* 蜂鳴器 *)
    (* Y3 治具停止：HMI 強制＝反轉程式輸出（11-11 現場要求：程式保持 ON 時可在手動停止中強制 OFF）。
       急停、切自動、HMI 斷線會解除強制（M820 OFF），Y3 回到程式值 *)
    IF M873 THEN
        Y3 := NOT M403;
    ELSE
        Y3 := M403;
    END_IF;
    Y4  := M404;           (* 螺絲機在安全位置（不可強制） *)
    Y5  := M405 OR M875;   (* 治具啟動／前進 *)
    Y6  := M406 OR M876;   (* 預留：過渡期同紅燈 *)
    Y7  := M407;           (* 預留 *)
    Y10 := M410 OR M878;   (* RC75 RETURN       XB00 *)
    Y11 := M411 OR M879;   (* RC75 RESET        XB01 *)
    Y12 := M412 OR M880;   (* RC75 CYCLE START  XB02 *)
    Y13 := M413 OR M881;   (* RC75 送螺絲       XB03 *)
    Y14 := (M414 AND NOT M883) OR M882;   (* RC75 TABLE 1 XB04；v3.10：強制 Y15 時程式的 Y14 讓開，才會是 TABLE 2 *)
    Y15 := M415 OR M883;   (* RC75 TABLE 2      XB05（第 2 點時 ON；v3.10 可強制） *)
END_IF;

(* ---- HMI 顯示燈 ---- *)
M205 := M11;          (* RC75 READY *)
M206 := M12;          (* RC75 HOME *)
M207 := NOT M12;      (* Z 不在原點（取代 v3.1 循環中） *)
M208 := M5;           (* 治具水平待命 *)
M209 := M10;          (* 安全光柵無遮斷 *)
M210 := M7;           (* 啟動鈕 *)
M211 := M6;           (* 治具停止 *)
M212 := (D100 = 12) OR (D100 = 14);   (* 等待中控放行 *)
M213 := M2113;                        (* 完工待收 *)

(* HMI 狀態文字 D2050：0 停止 1 待機中 2 加工中 3 等待中控 4 異常 5 手動 6 強制中 7 光柵暫停 *)
IF M203 OR M154 THEN
    D2050 := 4;
ELSIF M821 THEN
    D2050 := 6;
ELSIF M201 THEN
    D2050 := 5;
ELSIF M845 THEN
    D2050 := 7;
ELSIF M212 OR M213 THEN
    D2050 := 3;
ELSIF M200 AND (D100 = 10) THEN
    D2050 := 1;
ELSIF M200 THEN
    D2050 := 2;
ELSE
    D2050 := 0;
END_IF;

(* ---- 計數清除（停止中或 v3.18 自動待機步 10 才可） ---- *)
IF M130 AND (NOT M200 OR (D100 = 10)) THEN
    D300:D := 0;
    D302:D := 0;
    D304:D := 0;
    D230 := 0;  D231 := 0;  D232 := 0;  D233 := 0;
END_IF;

(* ---- 良率 0.1% ---- *)
IF D304:D > 0 THEN
    D306 := DINT_TO_INT(D300:D * 1000 / D304:D);
ELSE
    D306 := 0;
END_IF;

(* ---- v3.14 HMI v6 首頁用（只讀既有軟元件，不影響流程；畫面元件表 HMI/v6_bg/home_parts.md） ----
   M2400 工號已刷、M2401 序號已到、D2054 鎖付進度 0 未開始 / 1 加工中 / 2 本件完成
   D2053 下一步碼：100+D2052 停止中缺的條件；31 請刷工號；32 靜電未通過；40/41 本件 NG/OK；20+D2051 運轉中等待條件
   註：M2135（加工中）由 P75 算，這裡讀到的是上一個掃描的值 *)
M2400 := (D7019 <> 0) AND (D7019 <> 16#2020);
M2401 := (D7003 <> 0) AND (D7003 <> 16#2020);
IF M2111 THEN
    D2054 := 2;
ELSIF M2135 THEN
    D2054 := 1;
ELSE
    D2054 := 0;
END_IF;
IF NOT M200 THEN
    D2053 := 100 + D2052;
ELSIF M2051 AND NOT M2400 THEN
    D2053 := 31;
ELSIF NOT M2062 THEN
    D2053 := 32;
ELSIF M2111 AND (D100 = 10) THEN
    IF M2112 THEN D2053 := 41; ELSE D2053 := 40; END_IF;
ELSE
    D2053 := 20 + D2051;
END_IF;

(* ---- v3.14 HMI v6 首頁圖片顯示位元（GP-Pro EX 圖片只用單一位元當條件；只讀既有軟元件） ----
   M2410~M2421 = D2053 100~111、M2422~M2429 = D2053 20~27、M2430 = 31、M2431 = 32、M2432 = 40、M2433 = 41
   M2434 本件 NG、M2435 靜電檢查啟用、M2436~M2441 扭力/角度/高度 OK、NG *)
M2410 := (D2053 = 100);
M2411 := (D2053 = 101);
M2412 := (D2053 = 102);
M2413 := (D2053 = 103);
M2414 := (D2053 = 104);
M2415 := (D2053 = 105);
M2416 := (D2053 = 106);
M2417 := (D2053 = 107);
M2418 := (D2053 = 108);
M2419 := (D2053 = 109);
M2420 := (D2053 = 110);
M2421 := (D2053 = 111);
M2422 := (D2053 = 20);
M2423 := (D2053 = 21);
M2424 := (D2053 = 22);
M2425 := (D2053 = 23);
M2426 := (D2053 = 24);
M2427 := (D2053 = 25);
M2428 := (D2053 = 26);
M2429 := (D2053 = 27);
M2430 := (D2053 = 31);
M2431 := (D2053 = 32);
M2432 := (D2053 = 40);
M2433 := (D2053 = 41);
M2434 := M2111 AND NOT M2112;    (* 本件 NG *)
M2435 := (D214 = 1);              (* 靜電檢查啟用 *)
M2436 := (D7143 = 1);             (* 扭力 OK *)
M2437 := M2111 AND (D7143 = 0);   (* 扭力 NG *)
M2438 := (D7144 = 1);             (* 角度 OK *)
M2439 := M2111 AND (D7144 = 0);   (* 角度 NG *)
M2440 := (D7145 = 1);             (* 高度 OK *)
M2441 := M2111 AND (D7145 = 0);   (* 高度 NG *)

(* v3.18 首頁表格每顆判定、EMO 閃爍 *)
M2442 := (D7157 = 1);             (* 第 1 顆 OK *)
M2443 := (D7157 = 2);             (* 第 1 顆 NG *)
M2444 := (D7158 = 1);             (* 第 2 顆 OK *)
M2445 := (D7158 = 2);             (* 第 2 顆 NG *)
M2446 := NOT M0 AND SM412;        (* 急停中：每秒閃（疊在 M2447 上面） *)

(* v3.18 首頁機台狀態（原啟動／停止鍵的位置）D2055：1 急停中、2 未就緒（看下一步提示）、3 手動模式、
   4 待機（可按綠鍵）、5 等中控放行、6 作業中 *)
IF NOT M0 THEN D2055 := 1;
ELSIF M201 THEN D2055 := 3;
ELSIF NOT M200 THEN D2055 := 2;
ELSIF D100 = 10 THEN D2055 := 4;
ELSIF (D100 = 12) OR (D100 = 14) THEN D2055 := 5;
ELSE D2055 := 6;
END_IF;
M2447 := (D2055 = 1);
M2448 := (D2055 = 2);
M2449 := (D2055 = 3);
M2450 := (D2055 = 4);
M2451 := (D2055 = 5);
M2452 := (D2055 = 6);

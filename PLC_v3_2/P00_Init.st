(* ============================================================
   P00_Init  首掃描初始化（第一個執行）  v3.2
   專案：文字鎖螺絲機  主 PLC FX5S-30MR/ES
   v3.2：2026-11-02 現場對點後的新 I/O、兩點流程、HMI 強制（rt_3 定案 + H/H-2 現場回覆）
         時間參數單位一律 0.1 秒
   ============================================================ *)
IF SM402 THEN
    (* 參數若超出範圍就填入預設值（D200~D499 已在 CPU 參數設為停電保持） *)
    IF (D200 < 1) OR (D200 > 3) THEN D200 := 1; END_IF;   (* RC75 TABLE 編號（只接 TABLE 1，1 = Y14 常 ON） *)
    IF D210 <= 0 THEN D210 := 30;  END_IF;   (* 啟動逾時 3.0 秒 *)
    IF D211 <= 0 THEN D211 := 150; END_IF;   (* 鎖付逾時 15.0 秒 *)
    IF D212 <= 0 THEN D212 := 100; END_IF;   (* Z 軸回原點逾時 10.0 秒 *)
    IF D213 <= 0 THEN D213 := 300; END_IF;   (* 中控放行等待逾時 30.0 秒 *)
    IF (D214 < 0) OR (D214 > 1) THEN D214 := 0; END_IF;   (* 靜電檢查 0=不檢查 1=檢查（X3） *)
    IF D216 <= 0 THEN D216 := 50;  END_IF;   (* 中控心跳逾時 5.0 秒 *)
    IF D217 <= 0 THEN D217 := 300; END_IF;   (* v3.2 治具歸位（X5 ON）逾時 30.0 秒 *)
    IF (D218 < 0) OR (D218 > 1) THEN D218 := 0; END_IF;   (* v3.2 EMO 放開後 0=要按復歸 1=條件成立自動復歸 *)
    IF (D221 < 1) OR (D221 > 2) THEN D221 := 2; END_IF;   (* v3.2 每循環鎖付點數 *)
    IF D224 <= 0 THEN D224 := 20;  END_IF;   (* v3.2 光柵恢復確認 2.0 秒 *)
    IF D225 <= 0 THEN D225 := 5;   END_IF;   (* v3.2 CYCLE START 脈衝 0.5 秒 *)
    IF D226 <= 0 THEN D226 := 10;  END_IF;   (* v3.2 X0/X10 消抖 1.0 秒（D218=1 時用） *)
    IF D227 <= 0 THEN D227 := 20;  END_IF;   (* v3.2 HMI 心跳逾時 2.0 秒 *)
    IF D228 <= 0 THEN D228 := 300; END_IF;   (* v3.2 切換型強制自動解除 30 秒 *)
    IF D229 <= 0 THEN D229 := 30;  END_IF;   (* v3.2 按住型強制單次上限 3.0 秒 *)
    IF D234 <= 0 THEN D234 := 30;  END_IF;   (* v3.2 治具移動時間 3.0 秒（測試暫定，沒有到位訊號） *)
    IF D235 <= 0 THEN D235 := 5;   END_IF;   (* v3.2 Y5 治具啟動脈衝 0.5 秒 *)
    IF D521 <= 0 THEN D521 := 20;  END_IF;   (* 模擬：RC75 鎖付時間 2.0 秒 *)

    (* 上電一律停止、自動模式、非模擬 *)
    M50  := FALSE;   (* 模擬模式 *)
    M59  := FALSE;   (* 模擬模式（已接受的狀態） *)
    M104 := FALSE;   (* v3.2 單件 *)
    M105 := FALSE;   (* v3.2 立即停 *)
    M200 := FALSE;   (* 自動運轉中 *)
    M201 := FALSE;   (* 手動模式 *)
    M301 := FALSE;   (* 停止要求 *)
    M320 := FALSE;   (* 循環完成 鎖存 *)
    M321 := FALSE;   (* 締付 OK 鎖存 *)
    M322 := TRUE;    (* 本產品目前全部 OK *)
    M121 := FALSE;   (* 蜂鳴器靜音 *)
    M932 := FALSE;   (* 手動單次鎖付（M384~M1999 預設停電保持，要清） *)
    M933 := FALSE;
    D100 := 0;       (* 自動步序 *)
    D101 := 0;
    D110 := 0;       (* 復歸步序 *)
    D111 := 0;
    D222 := 0;       (* v3.2 目前第幾點 *)

    (* v3.2 EMO 保持、手動治具、HMI 強制（都在停電保持區，重開機一定要清） *)
    M841 := NOT X0;  (* 上電時急停按著就保持 Y3 *)
    M860 := TRUE;    (* 11-11：上電 Y3 脈衝 1 秒，讓治具復歸 *)
    D542 := 0;
    M844 := FALSE;   (* RESET 脈衝中 *)
    M845 := FALSE;   (* 光柵暫停 *)
    M850 := FALSE;   (* 手動 Y3 治具停止 *)
    M852 := FALSE;   (* 手動 Y5 脈衝中 *)
    K4M800 := 0;     (* 強制要求 M800~M815 *)
    K4M870 := 0;     (* 強制有效 M870~M885 *)
    M820 := FALSE;
    M821 := FALSE;
    M831 := FALSE;
    M832 := FALSE;
    D2003 := 0;      (* HMI 心跳計時 *)

    (* v3 中控 *)
    M2050 := FALSE;  (* v3.2 HMI Remote/Local 選擇：上電預設 Local（中控尚未測試） *)
    M2051 := FALSE;  (* 目前模式 Remote *)
    M2052 := TRUE;   (* 中控通訊中斷：看到心跳變化才解除 *)
    M2070 := FALSE;  (* 模擬中控 *)
    M2081 := FALSE;  (* 校時寫入中 *)
    M2111 := FALSE;  (* Result_Ready *)
    M2112 := FALSE;  (* Overall_Result *)
    M2113 := FALSE;  (* 完工待收（等 ACK完工） *)
    M2114 := FALSE;  (* 放行已使用 *)
    M154  := FALSE;  (* 完工待收時中控斷線 *)
    D2002 := 0;      (* 心跳計時 *)
END_IF;

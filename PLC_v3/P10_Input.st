(* ============================================================
   P10_Input  實體輸入 → 內部 M（只有這裡讀 X）  v3
   v3 新增：靜電 OK/NG 乾接點 M2060/M2061
   ============================================================ *)
IF NOT M50 THEN
    M0  := X0;    (* 緊急停止 NC：ON = 正常 *)
    M1  := X1;    (* 啟動按鈕 *)
    M2  := X2;    (* 復歸按鈕 *)
    M3  := X3;    (* 停止按鈕 *)
    M4  := X4;    (* RC75 扭力 NG    YB07（診斷用） *)
    M5  := X5;    (* 治具啟動要求 VB1-R1 *)
    M6  := X6;    (* 治具停止要求 VB1-R2 *)
    M7  := X7;    (* RC75 浮鎖 NG    YB10（診斷用） *)
    M10 := X10;   (* RC75 READY      YB00 *)
    M11 := X11;   (* RC75 原位置     YB01 *)
    M12 := X12;   (* RC75 ALARM      YB02 *)
    M13 := X13;   (* RC75 循環中     YB03 *)
    M14 := X14;   (* RC75 循環完成   YB04 *)
    M15 := X15;   (* RC75 鎖付 OK    YB13 *)
    M16 := X16;   (* RC75 螺絲不足   YB06 *)
    M17 := X17;   (* RC75 送料/取料異常 YB11 *)
    (* v3 靜電乾接點。FX5S-30M 的 X0~X17 已用完，暫定接在擴充輸入 X20/X21【待確認】 *)
    M2060 := X20; (* 靜電 OK *)
    M2061 := X21; (* 靜電 NG *)
ELSE
    M0  := X0 AND NOT M57;   (* M57 = HMI「模擬急停」 *)
    M1  := FALSE;
    M2  := FALSE;
    M3  := FALSE;
    M4  := FALSE;
    M5  := M54;
    M6  := M55;
    M7  := FALSE;
    M10 := M60;
    M11 := M61;
    M12 := M62;
    M13 := M63;
    M14 := M64;
    M15 := M65;
    M16 := M66;
    M17 := M67;
    M2060 := NOT M2065;   (* M2065 = HMI「模擬靜電 NG」 *)
    M2061 := M2065;
END_IF;

(* 實體按鈕與 HMI 按鈕合併 *)
M20 := M1 OR M100;    (* 啟動 *)
M21 := M3 OR M101;    (* 停止 *)
M22 := M2 OR M102;    (* 復歸 *)

(* 上升沿 *)
M30 := M20 AND NOT M31;  M31 := M20;   (* 啟動 *)
M32 := M21 AND NOT M33;  M33 := M21;   (* 停止 *)
M34 := M22 AND NOT M35;  M35 := M22;   (* 復歸 *)

(* 靜電條件：不檢查（D214=0）或 OK 且無 NG *)
M2062 := (D214 = 0) OR (M2060 AND NOT M2061);
